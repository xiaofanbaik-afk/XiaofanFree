-- FUNGSI INSTAN FISHING
local function AutoFishCycle()
    local currentTime = os.time() + os.clock()
    
    RemoteEvent:FireServer( "RodActivated", { LuckMulti = LUCK_MULTIPLIER, Mouse = { Target = WATER_TARGET, Hit = FIXED_HIT_CFRAME } }, currentTime )
    wait(CATCH_DELAY) 
    currentTime = os.time() + os.clock()
    RemoteEvent:FireServer( "GotFish", nil, currentTime )
end

-- FUNGSI AUTO SELL INVENTORY
local function AutoSellInventory()
    -- Menggunakan nilai acak kecil untuk waktu
    local UniqueTime = os.time() + os.clock() + math.random()
    
    if SellRemoteFunction then
        pcall(SellRemoteFunction.InvokeServer, SellRemoteFunction, "SellInventory", nil, UniqueTime)
    end
end

-- LOOP KONTROL INSTAN FISHING
task.spawn(function()
    while true do
        if Toggles.InstanFishingToggle.Value and RemoteEvent and WATER_TARGET then
            pcall(AutoFishCycle)
            wait(FISHING_DELAY) 
        else
            wait(0.1) -- Jeda kecil saat mati
        end
    end
end)

-- LOOP KONTROL AUTO SELL BACKPACK
task.spawn(function()
    local SELL_INTERVAL = 3 -- Jual inventaris setiap 3 detik (dapat disesuaikan)
    while true do
        if Toggles.SellBackpackToggle.Value and SellRemoteFunction then
            pcall(AutoSellInventory)
            wait(SELL_INTERVAL) 
        else
            wait(0.5) -- Jeda saat mati
        end
    end
end)
